{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::fraud-detection-project-2026-suresh",
                   "arn:aws:s3:::fraud-detection-project-2026-suresh/*"]
    },
    {
      "Sid": "PushImagesToECR",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken", "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload",
                 "ecr:UploadLayerPart", "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage",
                 "ecr:GetDownloadUrlForLayer", "ecr:DescribeRepositories", "ecr:CreateRepository"],
      "Resource": "*"
    },
    {
      "Sid": "DeployToEKS",
      "Effect": "Allow",
      "Action": ["eks:DescribeCluster", "eks:ListClusters"],
      "Resource": "*"
    },
    {
      "Sid": "StartRetrainingAndAlert",
      "Effect": "Allow",
      "Action": ["sagemaker:CreateProcessingJob", "sagemaker:DescribeProcessingJob", "sagemaker:AddTags", "sns:Publish"],
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyTheSageMakerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/FraudSageMakerRole"
    }
  ]
}

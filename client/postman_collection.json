          "raw": "{\n  \"txn_id\": \"TXN30082727\",\n  \"txn_timestamp\": \"2026-05-09T14:42:50\",\n  \"customer_id\": \"C100637\",\n  \"amount\": 591.0,\n  \"channel\": \"UPI\",\n  \"txn_type\": \"P2P_TRANSFER\",\n  \"payee_id\": \"ravi6352@ybl\",\n  \"merchant_category\": null,\n  \"remarks\": \"EMI\",\n  \"device_id\": \"D45404572\",\n  \"device_os\": \"Android\",\n  \"ip_country\": \"IN\",\n  \"txn_city\": \"Hubballi\",\n  \"is_international\": 0,\n  \"is_rooted_or_emulator\": 0,\n  \"vpn_or_proxy\": 0,\n  \"login_to_pay_seconds\": 19.1\n}",
          "options": {
